{
  "name": "meerkat-maze-runner",
  "version": "1.0.0",
  "description": "A 3D third-person survival game where a meerkat navigates procedurally generated garden hedge mazes while evading zombies",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "game",
    "three.js",
    "maze",
    "meerkat",
    "survival"
  ],
  "license": "MIT"
}
